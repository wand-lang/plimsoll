-- The arithmetic behind `plimsoll.millicores` and `plimsoll.bytes`: a
-- quantity read as an exact fraction. Private to the package.

import Regex
import Result
import String

let pow10 n = if n <= 0 then 1 else 10 * pow10 (n - 1)

-- What a suffix multiplies by, as a fraction: `m` is 1/1000, `Ki` is 1024,
-- `e3` is 1000.
let scale suffix =
  match suffix with
  | "" -> Ok (1, 1)
  | "m" -> Ok (1, 1000)
  | "k" -> Ok (pow10 3, 1)
  | "M" -> Ok (pow10 6, 1)
  | "G" -> Ok (pow10 9, 1)
  | "T" -> Ok (pow10 12, 1)
  | "P" -> Ok (pow10 15, 1)
  | "E" -> Ok (pow10 18, 1)
  | "Ki" -> Ok (1024, 1)
  | "Mi" -> Ok (1048576, 1)
  | "Gi" -> Ok (1073741824, 1)
  | "Ti" -> Ok (1099511627776, 1)
  | "Pi" -> Ok (1125899906842624, 1)
  | "Ei" -> Ok (1152921504606846976, 1)
  | s -> (
    match Regex.capture r/^[eE]([+-]?[0-9]+)$/ s with
    | [_, e] ->
      String.to_int e
      |> Result.map (fn n -> if n >= 0 then (pow10 n, 1) else (1, pow10 (0 - n)))
    | _ -> Error "'%{s}' is not a quantity suffix"
  )

-- A quantity as a fraction (numerator, denominator), counted exactly: a
-- float reads "0.1" as a little more than a tenth.
let amount (q: String) = (
  let text = String.trim q;
  match Regex.capture r/^([+-]?)([0-9]*)\.?([0-9]*)([a-zA-Z]*|[eE][+-]?[0-9]+)$/ text with
  | [_, sign, whole, frac, suffix] when !(String.empty? (whole ++ frac)) ->
    String.to_int (whole ++ frac)
    |> Result.and_then (fn digits ->
      scale suffix
      |> Result.map (fn (num, den) ->
        let n = if sign == "-" then 0 - digits * num else digits * num;
        (n, pow10 (String.length frac) * den)))
  | _ -> Error "'%{q}' is not a quantity"
)

-- Rounded up, as Kubernetes rounds a quantity it has to count in whole
-- units.
let ceil_div a b = if a >= 0 then (a + b - 1) / b else 0 - (0 - a) / b
