uses {IO, Shell(kubectl)}

-- An application in a few fields, checked by the API server of the cluster
-- that kubectl points at.
--
-- `App.deployment` and `App.service` make the two objects. The script
-- changes the Deployment with a record update, and asks the server to
-- validate each object with `Plimsoll.check!` (a server-side dry run).
-- Nothing on the cluster changes, so `wand --dry-run` runs the checks too.
import IO
import JSON
import Map
import Option

let App = import ../app
let Apps = import ../k8s/apps/v1
let Core = import ../k8s/core/v1
let Plimsoll = import ../plimsoll

let web =
  App.App(
    name = "web",
    image = "nginx:1.27",
    port = 8080,
    replicas = 2,
    env = Map.of_list [("MODE", "prod")],
    cpu = Some "100m",
    memory = Some "64Mi"
  )

let d = App.deployment web

-- A field that App does not have: a record update sets it.
let settled =
  Apps.Deployment(d, spec = Apps.DeploymentSpec(d.spec, minReadySeconds = Some 5))

let deployment =
  JSON.decode Apps.Deployment.decoder (Plimsoll.check! Apps.Deployment.encoder settled)

let service =
  JSON.decode Core.Service.decoder (Plimsoll.check! Core.Service.encoder (App.service web))

match (deployment, service) with
| (Ok d, Ok s) -> (
  IO.println
    "deployment: replicas %{d.spec.replicas}, minReadySeconds %{d.spec.minReadySeconds}";
  IO.println
    "service: type %{Option.and_then (fn (sp: Core.ServiceSpec) -> sp.type) s.spec}, clusterIP %{Option.and_then (fn (sp: Core.ServiceSpec) -> sp.clusterIP) s.spec}"
)
| (Error e, _) -> IO.println_err "the server's Deployment did not decode: %{e}"
| (_, Error e) -> IO.println_err "the server's Service did not decode: %{e}"
