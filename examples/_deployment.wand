uses {IO, Shell(kubectl)}

-- A Deployment built from the generated types, and checked by the API
-- server of the cluster that kubectl points at.
--
-- It encodes the Deployment with its derived encoder, asks the server to
-- validate it with `Plimsoll.check!` (a server-side dry run), decodes the
-- object the server would store, and compares the fields it set. Nothing on
-- the cluster changes, so `wand --dry-run` runs the check too.
import IO
import JSON
import Map
import Option

let Apps = import ../k8s/apps/v1
let Core = import ../k8s/core/v1
let Meta = import ../k8s/meta/v1
let Plimsoll = import ../plimsoll

let labels = Map.of_list [("app", "web")]

let web =
  Apps.Deployment(
    metadata = Some Meta.ObjectMeta(name = Some "web", labels = Some labels),
    spec = Apps.DeploymentSpec(
      replicas = Some 3,
      selector = Meta.LabelSelector(matchLabels = Some labels),
      strategy = Some Apps.DeploymentStrategy(
        type = Some Apps.DeploymentStrategyType.RollingUpdate,
        rollingUpdate = Some Apps.RollingUpdateDeployment(
          maxSurge = Some (Plimsoll.S "25%")
        )
      ),
      template = Core.PodTemplateSpec(
        metadata = Some Meta.ObjectMeta(labels = Some labels),
        spec = Some Core.PodSpec(
          restartPolicy = Some Core.PodSpecRestartPolicy.Always,
          containers = [
            Core.Container(
              name = "web",
              image = Some "nginx:1.27",
              imagePullPolicy = Some Core.ContainerImagePullPolicy.IfNotPresent,
              ports = Some [Core.ContainerPort(containerPort = 8080)]
            )
          ]
        )
      )
    )
  )

let sent = JSON.stringify (Apps.Deployment.encoder web)

let stored = Plimsoll.check! Apps.Deployment.encoder web

let back = JSON.decode Apps.Deployment.decoder stored

let pull (d: Apps.Deployment) =
  match d.spec.template.spec with
  | Some s -> (
    match s.containers with
    | [c :: _] -> c.imagePullPolicy
    | [] -> None
  )
  | None -> None

match back with
| Ok d -> (
  IO.println "sent:   %{sent}";
  IO.println
    "stored: replicas %{d.spec.replicas}, pull %{pull d}, strategy %{Option.map (fn (s: Apps.DeploymentStrategy) -> s.type) d.spec.strategy}";
  IO.println "same pull policy: %{pull d == pull web}"
)
| Error e -> IO.println_err "the server's object did not decode: %{e}"
