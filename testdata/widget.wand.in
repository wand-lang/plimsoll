uses {IO, Proc, Shell}

-- The Widget round trip, for tools/_e2e.wand. It imports the module that
-- `gen` writes for testdata/widget-crd.yaml, so it runs only in the copy
-- that e2e.wand makes, never in this directory. The `.in` keeps `wand t .`
-- (and so `upgrade`) from reading it here; e2e.wand copies it as
-- widget.wand.
import IO
import JSON
import List
import Map
import Proc

let Plimsoll = import ./plimsoll
let Ex = import ./k8s/example.com/v1alpha1
let Meta = import ./k8s/meta/v1

let w =
  Ex.Widget(
    metadata = Some Meta.ObjectMeta(name = Some "plimsoll-e2e", namespace = Some "default"),
    spec = Some Ex.WidgetSpec(
      size = 3,
      mode = Some Ex.WidgetSpecMode.Fast,
      port = Some (Plimsoll.S "http"),
      max_replicas = Some 5,
      owner = Some Ex.WidgetSpecOwner(team = Some "infra"),
      labels = Some (Map.from_list [("tier", "web")]),
      extra = Some (JSON.parse! `{"anything":[1,2]}`)
    )
  )

let main! () = (
  let _ = Plimsoll.check! Ex.Widget.encoder w;
  IO.println (Plimsoll.apply! Ex.Widget.encoder w);
  let got = Plimsoll.get_in! Ex.Widget.decoder "default" "widget" "plimsoll-e2e";
  let listed = Plimsoll.list_in! Ex.Widget.decoder "default" "widgets";
  IO.println (Plimsoll.delete_in! "default" "widget" "plimsoll-e2e");
  if got.spec == w.spec && List.length listed == 1 then IO.println "the Widget came back as it was sent"
  else (IO.println_err "the Widget did not come back as it was sent"; Proc.exit 1)
)

main! ()
