uses {Shell}

-- Tests for plimsoll.wand. No cluster is needed: a handler answers each
-- kubectl command, and a `Shell!command` case that does not resume gives
-- the command line itself.

import JSON
import List
import Map
import Option
import Result
import String
import YAML

let {test, group} = import Test
let Plimsoll = import ./plimsoll
let Apps = import ./k8s/apps/v1
let Core = import ./k8s/core/v1
let Meta = import ./k8s/meta/v1

let labels = Map.from_list [("app", "web")]

let web =
  Apps.Deployment(
    metadata = Some Meta.ObjectMeta(name = Some "web"),
    spec = Apps.DeploymentSpec(
      selector = Meta.LabelSelector(matchLabels = Some labels),
      template = Core.PodTemplateSpec(
        spec = Some Core.PodSpec(containers = [Core.Container(name = "web")])
      )
    )
  )

let enc = Apps.Deployment.encoder
let dec = Apps.Deployment.decoder

-- The command line a call would run.
let command_of thunk =
  handle thunk () with
  | Shell!command c _ -> c

-- What the server holds for `web`, as `kubectl get -o json` writes it.
let stored =
  `{"apiVersion":"apps/v1","kind":"Deployment","metadata":{"name":"web","namespace":"default"},"spec":{"replicas":1,"selector":{"matchLabels":{"app":"web"}},"template":{"spec":{"containers":[{"name":"web","imagePullPolicy":"Always"}]}}}}`

group "quantities" (fn () -> [
  test "millicores" (fn t ->
    t.eq
      [Ok 500, Ok 2000, Ok 100, Ok 1500]
      (List.map Plimsoll.millicores ["500m", "2", "0.1", "1.5"])),
  test "bytes" (fn t ->
    t.eq
      [Ok 134217728, Ok 1000000000, Ok 1024, Ok 1000, Ok 1610612736]
      (List.map Plimsoll.bytes ["128Mi", "1G", "1Ki", "1e3", "1.5Gi"])),
  test "a part of a unit is rounded up" (fn t -> t.eq (Ok 1) (Plimsoll.bytes "500m")),
  test "a suffix Kubernetes does not have" (fn t ->
    t.eq (Error "'MB' is not a quantity suffix") (Plimsoll.bytes "128MB")),
  test "text that is not a quantity" (fn t ->
    t.eq (Error "'lots' is not a quantity") (Plimsoll.bytes "lots")),
  test "a quantity too large for an Int is an Error" (fn t ->
    t.ok (Result.error? (Plimsoll.millicores "1Ei")))
])

group "the cluster" (fn () -> [
  test "apply is a server-side apply" (fn t ->
    t.eq
      "kubectl apply --server-side --field-manager=plimsoll -f -"
      (command_of (fn () -> Plimsoll.apply! enc web))),
  test "and sends the object as JSON" (fn t ->
    let sent =
      handle Plimsoll.apply! enc web with
      | Shell!run (_, input) _ -> input
    in
    t.eq (JSON.stringify (enc web)) sent),
  test "check asks the server and changes nothing" (fn t ->
    t.eq
      "kubectl apply --server-side --field-manager=plimsoll --dry-run=server -o json -f -"
      (command_of (fn () -> JSON.stringify (Plimsoll.check! enc web)))),
  test "and gives the object the server would store" (fn t ->
    let doc =
      handle Plimsoll.check! enc web with
      | Shell!run _ k -> k stored
    in
    t.eq
      (Ok (Some 1))
      (JSON.decode dec doc |> Result.map (fn (d: Apps.Deployment) -> d.spec.replicas))),
  test "get reads one object and decodes it" (fn t ->
    let d =
      handle Plimsoll.get! dec "deployment" "web" with
      | Shell!run _ k -> k stored
    in
    t.eq (Some "web") (d.metadata |> Option.and_then (fn (m: Meta.ObjectMeta) -> m.name))),
  test "with kubectl get" (fn t ->
    t.eq
      "kubectl get 'deployment' 'web' -o json"
      (command_of (fn () -> (let _ = Plimsoll.get dec "deployment" "web"; "")))),
  test "list reads the items" (fn t ->
    let ds =
      handle Plimsoll.list! dec "deployment" with
      | Shell!run _ k -> k `{"items":[%{stored},%{stored}]}`
    in
    t.eq 2 (List.length ds)),
  test "a document that is not the type is an Error" (fn t ->
    let r =
      handle Plimsoll.get dec "deployment" "web" with
      | Shell!run _ k -> k `{"kind":"Deployment"}`
    in
    t.ok (Result.error? r)),
  -- A value the types do not have usually means the cluster is newer than
  -- k8s/, so the error says how to find out.
  test "and the error says to check the types against the cluster" (fn t ->
    let r =
      handle Plimsoll.get dec "deployment" "web" with
      | Shell!run _ k -> k `{"kind":"Deployment"}`
    in
    t.ok
      (match r with
      | Error e -> String.contains? "The cluster may be newer than the types in k8s/" e
      | Ok _ -> false
      )),
  test "list says the same" (fn t ->
    let r =
      handle Plimsoll.list dec "deployment" with
      | Shell!run _ k -> k `{"items":[{"kind":"Deployment"}]}`
    in
    t.ok
      (match r with
      | Error e -> String.contains? "cli check" e
      | Ok _ -> false
      )),
  test "delete" (fn t ->
    t.eq
      "kubectl delete 'deployment' 'web'"
      (command_of (fn () -> Plimsoll.delete! "deployment" "web"))),
  test "get_in names the namespace" (fn t ->
    t.eq
      "kubectl get -n 'prod' 'deployment' 'web' -o json"
      (command_of (fn () -> (let _ = Plimsoll.get_in dec "prod" "deployment" "web"; "")))),
  test "list_in names the namespace" (fn t ->
    t.eq
      "kubectl get -n 'prod' 'deployment' -o json"
      (command_of (fn () -> (let _ = Plimsoll.list_in dec "prod" "deployment"; "")))),
  test "delete_in names the namespace" (fn t ->
    t.eq
      "kubectl delete -n 'prod' 'deployment' 'web'"
      (command_of (fn () -> Plimsoll.delete_in! "prod" "deployment" "web"))),
  test "manifest_yaml writes one YAML document for each object" (fn t ->
    t.eq
      [YAML.of_json (enc web), YAML.of_json (enc web)]
      (YAML.parse_all! (Plimsoll.manifest_yaml enc [web, web]))),
  test "manifest writes one JSON list and reaches nothing" (fn t ->
    t.eq
      "[%{JSON.stringify (enc web)},%{JSON.stringify (enc web)}]"
      (Plimsoll.manifest enc [web, web]))
])
