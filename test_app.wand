uses {Shell}

-- Tests for app.wand. No cluster is needed: a handler answers each kubectl
-- command.

import JSON
import Map
import Option
import YAML

let {test, group} = import Test
let App = import ./app
let Plimsoll = import ./plimsoll
let Apps = import ./k8s/apps/v1
let Core = import ./k8s/core/v1
let Meta = import ./k8s/meta/v1

let web = App.App(name = "web", image = "nginx:1.27", port = 8080, replicas = 3)

let full =
  App.App(
    web,
    env = Map.of_list [("MODE", "prod"), ("LOG", "info")],
    cpu = Some "250m",
    memory = Some "128Mi"
  )

-- The one container of a Deployment's pods.
let container_of (d: Apps.Deployment) =
  match d.spec.template.spec with
  | Some s -> (
    match s.containers with
    | [c :: _] -> Some c
    | [] -> None
  )
  | None -> None

let labels_of (m: Option Meta.ObjectMeta) =
  Option.and_then (fn (m: Meta.ObjectMeta) -> m.labels) m

let service_spec (a: App.App) =
  match (App.service a).spec with
  | Some s -> s
  | None -> Core.ServiceSpec()

group "the Deployment" (fn () -> [
  test "has the name, the replicas and the image" (fn t ->
    let d = App.deployment web;
    t.eq (Some "web", Some 3, Some (Some "nginx:1.27")) (
      Option.and_then (fn (m: Meta.ObjectMeta) -> m.name) d.metadata,
      d.spec.replicas,
      Option.map (fn (c: Core.Container) -> c.image) (container_of d)
    )),
  test "one set of labels for the object, the selector and the pods" (fn t ->
    let d = App.deployment web;
    let want = Some (Map.of_list [("app", "web")]);
    t.eq [want, want, want] [
      labels_of d.metadata,
      d.spec.selector.matchLabels,
      labels_of d.spec.template.metadata
    ]),
  test "the container listens on the port" (fn t ->
    t.eq
      (Some (Some [Core.ContainerPort(containerPort = 8080)]))
      (Option.map (fn (c: Core.Container) -> c.ports) (container_of (App.deployment web)))),
  test "no env and no requests when none are given" (fn t ->
    t.eq
      (Some (None, None))
      (Option.map
        (fn (c: Core.Container) -> (c.env, c.resources))
        (container_of (App.deployment web)))),
  test "the env, in the order it is written" (fn t ->
    t.eq
      (Some
        (Some [
          Core.EnvVar(name = "MODE", value = Some "prod"),
          Core.EnvVar(name = "LOG", value = Some "info")
        ]))
      (Option.map (fn (c: Core.Container) -> c.env) (container_of (App.deployment full)))),
  test "the requests that are given" (fn t ->
    let mem = App.App(web, memory = Some "64Mi");
    t.eq [
      Some
        (Some Core.ResourceRequirements(
          requests = Some (Map.of_list [("cpu", "250m"), ("memory", "128Mi")])
        )),
      Some
        (Some Core.ResourceRequirements(requests = Some (Map.of_list [("memory", "64Mi")])))
    ] [
      Option.map
        (fn (c: Core.Container) -> c.resources)
        (container_of (App.deployment full)),
      Option.map (fn (c: Core.Container) -> c.resources) (container_of (App.deployment mem))
    ]),
  test "a record update changes the object before it is applied" (fn t ->
    let d = App.deployment web;
    let d2 = Apps.Deployment(d, spec = Apps.DeploymentSpec(d.spec, paused = Some true));
    t.eq (Some true, Some 3) (d2.spec.paused, d2.spec.replicas))
])

group "the Service" (fn () -> [
  test "selects the app's pods" (fn t ->
    t.eq (Some (App.labels web)) (service_spec web).selector),
  test "sends the port to the container's port" (fn t ->
    t.eq
      (Some [Core.ServicePort(port = 8080, targetPort = Some (Plimsoll.I 8080))])
      (service_spec web).ports),
  test "has the app's name" (fn t ->
    t.eq
      (Some "web")
      (Option.and_then (fn (m: Meta.ObjectMeta) -> m.name) (App.service web).metadata))
])

group "the cluster" (fn () -> [
  test "manifest is the Deployment and the Service" (fn t ->
    let d = JSON.stringify (Apps.Deployment.encoder (App.deployment web));
    let s = JSON.stringify (Core.Service.encoder (App.service web));
    t.eq "[%{d},%{s}]" (App.manifest web)),
  test "manifest_yaml is the Deployment and the Service, as YAML" (fn t ->
    t.eq
      [
        YAML.of_json (Apps.Deployment.encoder (App.deployment web)),
        YAML.of_json (Core.Service.encoder (App.service web))
      ]
      (YAML.parse_all! (App.manifest_yaml web))),
  test "apply sends the Deployment, then the Service" (fn t ->
    let sent =
      handle App.apply! web with
      | Shell!run (_, input) k -> k input
    in
    t.eq
      [
        JSON.stringify (Apps.Deployment.encoder (App.deployment web)),
        JSON.stringify (Core.Service.encoder (App.service web))
      ]
      sent)
])
